# ──────────────────────────────────────────────
# Inkwell — Environment Variables
# Copy to .env and fill in your values
# ──────────────────────────────────────────────

# Google Cloud
PROJECT_ID=your-project-id
REGION=us-central1
ASSETS_BUCKET=your-project-id-inkwell-assets
JOBS_TOPIC=inkwell-jobs

# ── Models (Vertex AI) ──────────────────────
TEXT_MODEL=gemini-3.5-flash
IMAGE_MODEL_DEV=gemini-3.1-flash-image
IMAGE_MODEL_FINAL=gemini-3-pro-image
VEO_MODEL=veo-3.1-generate-001
GEMMA_MODEL=gemma-3-4b-it
TTS_VOICE=en-US-Chirp3-HD-Puck

# ── Cost Controls ⚠️ ────────────────────────
# LEAVE COST_MODE=DEV while building!
COST_MODE=DEV
MAX_IMAGES_PER_PROJECT=40
MAX_CRITIC_ITERS_DEV=2
MAX_CRITIC_ITERS_PREVIEW=2
MAX_CRITIC_ITERS_FINAL=3
PARALLEL_PANELS=3
MAX_MAIN_CHARACTERS=3
DEFAULT_PAGES=6

# ── Local Dev ───────────────────────────────
# Set to "true" to enable the /worker/trigger endpoint
LOCAL_DEV=true

# ── Firebase (Frontend) ────────────────────
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
