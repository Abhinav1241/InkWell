# Inkwell — Worker Service Dockerfile
# Includes headless render deps + fonts for compositing

FROM python:3.12-slim

WORKDIR /app

# System deps for Pillow + fonts for lettering
RUN apt-get update && apt-get install -y --no-install-recommends \
    libfreetype6-dev libjpeg62-turbo-dev libpng-dev \
    libcairo2-dev libpango1.0-dev libgdk-pixbuf2.0-dev \
    fonts-dejavu-core fonts-liberation fonts-noto-core \
    && rm -rf /var/lib/apt/lists/*

# Python deps
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend
COPY backend/ ./backend/

# Expose port for Pub/Sub push
EXPOSE 8080

# Run as push subscriber
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8080"]
